---
import { ArrowRight } from "lucide-react";
import ProjectCard from "../card/project-card.astro";
import { getProjectImages } from "../../utils/imageFinder";
import { projects } from "../../datas/projects";
---

<section id="projects" class="border-y border-border px-4 py-24 md:px-8 lg:px-16">
  <div class="mx-auto max-w-6xl">
    <div class="mb-14 flex flex-wrap items-end justify-between gap-5">
      <div>
        <p class="mb-3 font-mono text-xs uppercase tracking-[0.25em] text-primary/60">Selected work</p>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl">Projects</h2>
      </div>
      <a
        href="/projects"
        class="text-primary hover:text-primary/80 inline-flex items-center gap-2"
      >
        See all projects
        <ArrowRight size={16}/>
      </a>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        projects.map((project) => {
          const images = getProjectImages(project.title);
          return <ProjectCard {...project} images={images} />;
        })
      }
    </div>
  </div>
</section>
