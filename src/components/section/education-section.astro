---
const education = [
  {
    period: "Sept 2024 — 2027",
    degree: "Master of engineering in computer information science",
    school: "CESI Lyon",
    coursework: "IT, Big Data, Software Development, IoT, Web Development, Machine Learning",
  },
  {
    period: "Sept 2022 — 2024",
    degree: "Advanced Technician's certificate in information technology",
    school: "Ecole ISITECH",
    coursework: "Web Development, Software Development, IT, Data structures",
  },
];
---

<section id="education" class="px-4 py-24 md:px-8 lg:px-16">
  <div class="mx-auto max-w-6xl">
    <div class="mb-14 grid gap-5 md:grid-cols-[1fr_1.2fr] md:items-end">
      <div>
        <p class="mb-3 font-mono text-xs uppercase tracking-[0.25em] text-primary/60">02 / Foundation</p>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl">Education</h2>
      </div>
      <p class="max-w-xl text-sm leading-7 text-muted-foreground">The ideas, disciplines, and habits that continue to inform how I approach every project.</p>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {education.map((item, index) => (
        <article class="group border border-border bg-card p-7 transition-colors hover:border-primary md:p-9">
          <div class="mb-12 flex items-center justify-between">
            <span class="font-mono text-xs uppercase tracking-wider text-muted-foreground">{item.period}</span>
            <span class="font-mono text-xs text-primary/50">0{index + 1}</span>
          </div>
          <h3 class="max-w-md text-2xl font-semibold leading-tight tracking-tight group-hover:text-primary">{item.degree}</h3>
          <p class="mt-3 text-sm font-medium text-primary">{item.school}</p>
          <p class="mt-5 max-w-md text-sm leading-7 text-muted-foreground">{item.coursework}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  article { transition: transform 180ms ease, box-shadow 180ms ease; }
  article:hover { transform: translateY(-4px); box-shadow: 8px 8px 0 hsl(var(--primary) / 0.12); }
</style>
   
