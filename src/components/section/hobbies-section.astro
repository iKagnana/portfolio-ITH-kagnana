---
const hobbies = [
  {
    title: "Digital and traditional drawing",
    description: "Expressing creativity through art in various forms",
    icon: "✎",
    iconLabel: "Drawing icon",
  },
  {
    title: "Reading",
    description: "Diving into stories and discovering new perspectives",
    icon: "▤",
    iconLabel: "Reading icon",
  },
  {
    title: "Travel",
    description: "Exploring new cultures and broadening my horizons",
    icon: "⌁",
    iconLabel: "Travel icon",
  },
  {
    title: "Music",
    description: "Listening to diverse genres and discovering new artists",
    icon: "♪",
    iconLabel: "Music icon",
  },
  {
    title: "Cooking & eating",
    description: "Experimenting with new recipes and flavors",
    icon: "⌂",
    iconLabel: "Cooking icon",
  },
];
---

<section id="hobbies" class="px-4 py-24 md:px-8 lg:px-16">
  <div class="mx-auto max-w-6xl space-y-12">
    <div class="grid gap-5 md:grid-cols-[1fr_1.2fr] md:items-end">
      <div>
        <p class="mb-3 font-mono text-xs uppercase tracking-[0.25em] text-primary/60">Off-screen</p>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl">Hobbies</h2>
      </div>
      <p class="max-w-xl text-sm leading-7 text-muted-foreground">The interests that keep curiosity active beyond the screen and bring fresh perspective back into my work.</p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {hobbies.map((hobby) => (
        <article class="group rounded-xl border border-border bg-card p-6 transition-transform duration-200 hover:-translate-y-1 hover:border-primary hover:shadow-[8px_8px_0_hsl(var(--primary)/0.12)]">
          <div class="mb-10 flex items-start justify-between">
            <span class="flex h-10 w-10 items-center justify-center rounded-full border border-primary/30 font-serif text-2xl text-primary" role="img" aria-label={hobby.iconLabel}>{hobby.icon}</span>
            <span class="font-mono text-xs uppercase tracking-wider text-muted-foreground">Interest</span>
          </div>
          <h3 class="text-xl font-semibold tracking-tight group-hover:text-primary">{hobby.title}</h3>
          <p class="mt-3 text-sm leading-7 text-muted-foreground">{hobby.description}</p>
        </article>
      ))}
    </div>

    <div class="rounded-xl border border-primary bg-primary p-8 text-primary-foreground">
      <h3 class="text-2xl font-bold mb-3">Always Seeking New Experiences</h3>
      <p class="text-lg opacity-90">
        I believe that life is a continuous adventure. Every day is an
        opportunity to learn something new and grow.
      </p>
    </div>
  </div>
</section>
