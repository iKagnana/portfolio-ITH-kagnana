<section class="flex min-h-screen items-center px-4 pt-24 md:px-8 lg:px-16">
  <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-[1.1fr_0.9fr]">
    <div class="space-y-6">
      <div>
        <h1 class="text-5xl font-bold mb-4 text-primary">Hi!</h1>
        <p class="text-lg text-muted-foreground leading-relaxed">
          I'm Kagnana, iOS developer studying as a software engineer in Lyon
        </p>
      </div>
      <!-- ChevronDown SVG icon -->
      <svg
        class="h-6 w-6 animate-bounce"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 9l-7 7-7-7"></path>
      </svg>
    </div>
    <div class="flex justify-center">
      <img
        src="/me.png"
        alt="Kagnana ITH"
        class="w-full max-w-md rounded-full"
      />
    </div>
  </div>
</section>
