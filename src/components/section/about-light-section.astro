---
const values = [
  {
    icon: `/icons/flame.svg`,
    label: "Ambition",
  },
  {
    icon: `/icons/lightbulb.svg`,
    label: "Curiosity",
  },
  {
    icon: `/icons/sparkles.svg`,
    label: "Creativity",
  },
  {
    icon: `/icons/diameter.svg`,
    label: "Simplicity",
  },
];
---

<section id="about" class="py-20 px-6">
  <div class="container w-full mx-auto">
    <h2 class="text-4xl font-bold text-center mb-8">WHO AM I ?</h2>

    <p
      class="mx-auto mb-10 max-w-3xl text-center leading-relaxed text-muted-foreground"
    >
      I am an iOS developer and a Computer Science student based in Lyon,
      France. I have a deep passion for building innovative applications and
      collaborating with people worldwide. To become a more versatile and
      autonomous engineer, I am currently diving into DevOps, DevSecOps, and
      infrastructure security—bridging the gap between creative development and
      robust, secure deployments.
    </p>

    <div class="mx-auto mb-12 grid max-w-3xl gap-4 sm:grid-cols-2">
      <div
        class="rounded-lg border border-border bg-background p-5 text-left shadow-sm"
      >
        <p
          class="mb-2 font-mono text-xs uppercase tracking-wider text-primary/60"
        >
          Current position
        </p>
        <p class="font-semibold text-foreground">iOS Developer</p>
        <p class="mt-1 text-sm text-muted-foreground">WIMOVA · Lyon, France</p>
      </div>
      <div
        class="rounded-lg border border-border bg-background p-5 text-left shadow-sm"
      >
        <p
          class="mb-2 font-mono text-xs uppercase tracking-wider text-primary/60"
        >
          Current education
        </p>
        <p class="font-semibold text-foreground">
          Engineering degree in Computer Science
        </p>
        <p class="mt-1 text-sm text-muted-foreground">
          CESI · Cybersecurity track
        </p>
      </div>
    </div>

    <div class="flex justify-center gap-4 mb-12">
      <a
        href="/resume.pdf"
        class="inline-flex items-center bg-primary hover:bg-primary/90 text-white font-medium rounded-md px-4 py-2 flex-wrap justify-center"
      >
        View Resume
      </a>
      <a
        href="/profile"
        class="inline-flex items-center border border-primary text-primary hover:bg-primary/10 bg-transparent font-medium rounded-md px-4 py-2"
      >
        View my detailed profile
      </a>
    </div>

    <div class="bg-secondary py-12 rounded-lg">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 px-6">
        {
          values.map((value) => (
            <div class="bg-background p-6 flex flex-col items-center justify-center gap-3 border-0 shadow-sm rounded-lg">
              <img
                src={value.icon}
                alt={`${value.label} icon`}
                class="h-8 w-8"
              />
              <span class="text-sm font-medium">{value.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
