---

<section id="contact" class="border-t border-border px-4 py-24 md:px-8 lg:px-16">
  <div class="mx-auto max-w-6xl">
    <div class="mb-14 grid gap-5 md:grid-cols-[1fr_1.2fr] md:items-end">
      <div>
        <p class="mb-3 font-mono text-xs uppercase tracking-[0.25em] text-primary/60">Contact</p>
        <h2 class="text-4xl font-bold tracking-tight md:text-5xl">Let&apos;s connect</h2>
      </div>
      <p class="max-w-xl text-sm leading-7 text-muted-foreground">Have a project in mind or want to talk software? I&apos;d be glad to hear from you.</p>
    </div>
    <div class="grid md:grid-cols-2 gap-12">
      <!-- Illustration -->
      <div class="flex items-center justify-center">
        <img
          src="/me_phone.png"
          alt="Contact Illustration"
          class="w-full h-auto max-w-md"
        />
      </div>
      <!-- Contact Info -->
      <div class="space-y-8">
        <div>
          <h3 class="text-2xl font-semibold mb-6">Keep in touch</h3>
          <p class="text-muted-foreground leading-relaxed mb-8">
            Feel free to reach out to me to discuss your projects, collaboration
            opportunities, or simply to chat about software development.
          </p>
        </div>
        <div class="space-y-4">
          <div class="flex items-center gap-4">
            <div class="bg-secondary p-3 rounded-lg">
              <img
                src="/icons/mailbox.svg"
                alt="Mail"
                class="h-5 w-5 text-primary color"
              />
            </div>
            <div>
              <p class="font-medium">Email</p>
              <p class="text-muted-foreground">ikagnana@gmail.com</p>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <div class="bg-secondary p-3 rounded-lg">
              <img
                src="/icons/map-pin.svg"
                alt="Location"
                class="h-5 w-5 text-primary"
              />
            </div>
            <div>
              <p class="font-medium">Localisation</p>
              <p class="text-muted-foreground">Lyon, France</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
